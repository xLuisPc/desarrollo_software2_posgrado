{
  "name": "campus-norte",
  "version": "1.0.0",
  "private": true,
  "description": "Explora universidades y prepara tu pr\u00f3xima visita con el clima de su ciudad.",
  "scripts": {
    "start": "concurrently -k -n API,ANGULAR -c green,cyan \"npm:server:dev\" \"npm:client\"",
    "client": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "server:dev": "node --watch --env-file-if-exists=.env server/index.mjs",
    "build": "ng build",
    "serve:prod": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "express": "^5.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@playwright/test": "^1.58.0",
    "concurrently": "^9.2.0",
    "node": "^24.15.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
